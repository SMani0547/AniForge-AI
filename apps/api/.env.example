# Copy to .env locally. Never place a Gemini key in apps/web or VITE_*.
PORT=8080
NODE_ENV=development
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_REAL_AI=false
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
AI_TIMEOUT_MS=300000
# Local Firebase only: use application-default credentials OR emulator variables.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# Future generation worker configuration (not implemented in Phase 1):
# CLOUD_TASKS_QUEUE=aniforge-generation
# CLOUD_TASKS_LOCATION=us-central1
# WORKER_URL=https://YOUR_PRIVATE_WORKER/internal/jobs/execute
# TASKS_SERVICE_ACCOUNT=tasks-invoker@YOUR_PROJECT.iam.gserviceaccount.com
