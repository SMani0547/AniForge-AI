# Copy to .env locally. Never place a Gemini key in apps/web or VITE_*.
PORT=8080
NODE_ENV=development
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_REAL_AI=false
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
AI_TIMEOUT_MS=300000
# Synchronous scene analysis is bounded below the Hosting proxy timeout.
ANALYSIS_TIMEOUT_MS=40000
MAX_ANALYSES_PER_USER_PER_DAY=20
# Local Firebase only: use application-default credentials OR emulator variables.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# Enable only after deploying the private worker, queue and scheduled recovery.
ENABLE_VIDEO_GENERATION=false
MAX_VIDEOS_PER_USER_PER_DAY=3
CLOUD_TASKS_QUEUE=aniforge-generation
CLOUD_TASKS_LOCATION=us-central1
# Exact Cloud Run origin, WITHOUT trailing slash or handler path. Also the OIDC audience.
WORKER_URL=
TASKS_SERVICE_ACCOUNT=
# Worker uses the same project/bucket, ENABLE_REAL_AI and Secret Manager key.
# Its AI deadline is capped at 300000 ms; CLI smoke deadlines remain independent.
