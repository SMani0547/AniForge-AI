{
  "name": "@aniforge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "start": "node dist/server.js",
    "smoke:analysis": "tsx --env-file-if-exists=.env scripts/smoke.ts analysis",
    "smoke:video": "tsx --env-file-if-exists=.env scripts/smoke.ts video",
    "smoke:edit": "tsx --env-file-if-exists=.env scripts/smoke.ts edit"
  },
  "dependencies": {
    "@aniforge/shared": "0.1.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@google/genai": "2.28.0",
    "fastify": "^5.7.4",
    "firebase-admin": "^14.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
