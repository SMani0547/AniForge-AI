# Public Firebase web app configuration; never put a Gemini API key here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Local development uses the Vite proxy. Production must set the full Cloud Run URL
# ending in /api/v1 and allow the Hosting origin in the API CORS configuration.
VITE_API_BASE_URL=/api/v1
# Enable only after Anonymous is enabled in Firebase Authentication.
VITE_ENABLE_ANONYMOUS_AUTH=false
# Optional development-only Firebase Auth emulator URL. Backend must use matching emulator/project.
VITE_FIREBASE_AUTH_EMULATOR_URL=
